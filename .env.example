# Modelo de Variáveis de Ambiente (.env.example)

# Configurações da Aplicação
VITE_APP_TITLE="O.S. Preventiva - Escadas Rolantes"
VITE_COMPANY_NAME="TK Elevator (TKE)"
VITE_NORMA_STANDARD="TITS-502P"

# API e Backend
# Em desenvolvimento local com Vite, use "/api" (ou deixe vazio para usar a rota relativa)
VITE_API_URL="/api"

# Configurações do Servidor SMTP (Nodemailer)
# Exemplos de Host:
# - Gmail: smtp.gmail.com (Porta 587 com STARTTLS ou 465 com SSL)
# - Outlook / Office 365: smtp-mail.outlook.com ou smtp.office365.com (Porta 587)
# - Hostinger / cPanel / Titan: smtp.titan.email / mail.seudominio.com (Porta 465 ou 587)
# - SendGrid: smtp.sendgrid.net (Porta 587)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="seu-email@gmail.com"
# IMPORTANTE para Gmail: Utilize uma "Senha de App" de 16 letras gerada na Conta Google > Segurança > Verificação em duas etapas
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="TK Elevator <seu-email@gmail.com>"
SMTP_TO_DEFAULT="destinatario@cliente.com"

# Funcionalidades
VITE_ENABLE_DEMO_FILL="true"
