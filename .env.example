# Modelo de Variáveis de Ambiente (.env.example)

# Configurações da Aplicação
VITE_APP_TITLE="O.S. Preventiva - Escadas Rolantes"
VITE_COMPANY_NAME="TK Elevator (TKE)"
VITE_NORMA_STANDARD="TITS-502P"

# API e Backend
VITE_API_URL="http://localhost:3000/api"

# Configurações de E-mail Automático (EmailJS - Opcional)
VITE_EMAILJS_PUBLIC_KEY="YOUR_PUBLIC_KEY"
VITE_EMAILJS_SERVICE_ID="YOUR_SERVICE_ID"
VITE_EMAILJS_TEMPLATE_ID="YOUR_TEMPLATE_ID"

# Funcionalidades
VITE_ENABLE_DEMO_FILL="true"
